# Settings. Copy this file to config/.env (never committed) and fill in the values.
# Non-secret keys carry their default. Secret keys are empty.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-sol
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=5
CV_FOLDER=data/sample/cvs
JOB_FOLDER=data/sample/job_descriptions
EXTRACT_PROMPT_PATH=prompts/extract_cv.md
MATCH_PROMPT_PATH=prompts/match_cv_to_job.md
EVAL_GROUND_TRUTH_PATH=data/sample/ground_truth.tsv
EVAL_GOLD_JOBS_PATH=data/sample/gold_jobs.json
EVAL_TOP_K=3
EVAL_MIN_RELEVANT_IN_TOP_K=2
EVAL_MIN_DATE_MATCH_PERCENT=90
WEB_ROOT=src/web
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
